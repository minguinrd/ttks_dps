# Flask entrypoint for the flask CLI (the Docker image sets this itself).
FLASK_APP=wsgi:app
# Session/CSRF signing key — use a long random value outside local dev.
SECRET_KEY=change-me
# Directory for the SQLite database and avatar uploads (use /data in Docker).
DATA_DIR=./data
# Initial admin account created by `flask seed-admin` (idempotent, forced password change).
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-me
# Optional Google sign-in (both must be set for the button and /auth/google routes to work).
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Daily SQLite backups: run at BACKUP_HOUR ("HH:MM", local time) and keep the newest BACKUP_KEEP files.
BACKUP_HOUR=03:00
BACKUP_KEEP=7
